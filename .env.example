# Copy this file to .env locally and fill in rotated values.
# Never commit .env, broker tokens, PINs or TOTP secrets.
ANGELONE_API_KEY=replace_with_rotated_api_key
ANGELONE_CLIENT_ID=replace_with_client_id
ANGELONE_PIN=replace_with_rotated_pin
ANGELONE_TOTP_SECRET=replace_with_rotated_totp_secret
# Fundamentals stay server-side. Paste your EODHD dashboard token only into
# the local .env file, never into this tracked example or a frontend variable.
EODHD_API_TOKEN=replace_with_eodhd_api_token
EODHD_DEFAULT_EXCHANGE=NSE
EODHD_TIMEOUT_SECONDS=20
PAPER_TRADING=true
LIVE_TRADING=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
