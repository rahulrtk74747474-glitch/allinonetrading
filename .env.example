# Copy this file to .env locally and fill in rotated values.
# Never commit .env, broker tokens, PINs or TOTP secrets.
ANGELONE_API_KEY=replace_with_rotated_api_key
ANGELONE_CLIENT_ID=replace_with_client_id
ANGELONE_PIN=replace_with_rotated_pin
ANGELONE_TOTP_SECRET=replace_with_rotated_totp_secret
PAPER_TRADING=true
LIVE_TRADING=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
