# Copy this file to .env and fill in the values locally.
# Never commit .env, send it in chat, or put it in an APK/IPA/web bundle.

# Application safety defaults
APP_ENV=development
PAPER_TRADING=true
LIVE_TRADING=false

# Angel One SmartAPI
ANGELONE_API_KEY=replace_with_rotated_api_key
ANGELONE_CLIENT_ID=replace_with_client_id
ANGELONE_PIN=replace_with_rotated_pin
ANGELONE_TOTP_SECRET=replace_with_rotated_totp_secret

# Backend settings (to be used when the API is added)
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql://localhost/allinonetrading
